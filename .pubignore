# Build artifacts at any level (root package and example/).
build/
web/
android/

# The benchmark package is repo-level engineering artifact — not part of the
# published archive either.
benchmark/
docs/

# Local-dev dependency overrides (environment-specific, resolved from a
# sibling checkout) — must never ship in the archive. `.pubignore` takes
# precedence over `.gitignore`, so the gitignore rule alone would not hide it.
pubspec_overrides.yaml

# IDE/editor junk.
*.iml
.idea/