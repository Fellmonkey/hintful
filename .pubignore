# Build artifacts at any level (root package and example/).
build/
web/
android/

# The benchmark package is repo-level engineering artifact — not part of the
# published archive either.
benchmark/
docs/

# Local-dev dependency overrides (environment-specific, resolved from a
# sibling checkout) — must never ship in the archive. `.pubignore` takes
# precedence over `.gitignore`, so the gitignore rule alone would not hide it.
pubspec_overrides.yaml

# IDE/editor junk.
*.iml
.idea/

# Generated docs, tooling state and CI plumbing. The archive is normally
# shaped by git tracking on top of this file, but a checkout without git
# (a tarball, a vendored copy) would otherwise ship all of it — state the
# essentials here so the rule does not depend on `.gitignore` still being
# consulted alongside.
**/doc/api/
.dart_tool/
coverage/
pubspec.lock
.metadata
.github/
.flutter-plugins
.flutter-plugins-dependencies
